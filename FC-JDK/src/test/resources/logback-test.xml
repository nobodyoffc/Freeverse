<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{24} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="fudp.node.FudpNode" level="DEBUG"/>
    <logger name="fudp.stream.StreamManager" level="DEBUG"/>
    <logger name="fudp.Protocol" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
